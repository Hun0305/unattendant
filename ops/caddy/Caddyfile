# unattendant.dev 정적 사이트. 외부 노출은 Cloudflare Tunnel만 쓰므로 127.0.0.1에만 붙는다.
# TLS는 Cloudflare가 맡는다.
{
	admin off
	auto_https off
	persist_config off
}

http://:8080 {
	bind 127.0.0.1
	root * /home/hun/unattendant-live/site/public
	encode zstd gzip
	file_server

	header /css/* Cache-Control "public, max-age=31536000, immutable"

	handle_errors 404 {
		handle /en/* {
			rewrite * /en/404.html
			file_server
		}
		handle {
			rewrite * /404.html
			file_server
		}
	}
}

# 승인 대기 초안의 미리보기 (docs/blogops.md 11절). preview.unattendant.dev → 터널 → 여기.
# 폴더 이름이 추측할 수 없는 토큰이고 폴더 목록은 보여 주지 않는다. 승인 대기가 끝나면 폴더가 지워진다.
# 읽기 전용 정적 서빙뿐이다. 이 포트로 들어온 요청은 초안을 바꿀 수 없다.
http://:8081 {
	bind 127.0.0.1
	root * /home/hun/unattendant-live/state/previews
	encode zstd gzip

	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	route {
		# 점으로 시작하는 이름(만드는 중인 폴더 등)은 내주지 않는다
		@hidden path_regexp hidden (^|/)\.
		respond @hidden 404

		respond /robots.txt <<TEXT
			User-agent: *
			Disallow: /
			TEXT 200

		# 사이트 CSS가 /fonts/…를, 상태 띠가 /status.json을 절대 경로로 부른다.
		# 공개 사이트와 같은 파일이라 공개 사이트 폴더에서 그대로 내준다.
		# 글꼴은 이름에 해시가 있는 공개 파일이라 캐시를 허용한다 (폰에서 페이지마다 다시 받지 않게)
		header /fonts/* Cache-Control "public, max-age=31536000, immutable"
		file_server /fonts/* {
			root /home/hun/unattendant-live/site/public
		}
		file_server /status.json {
			root /home/hun/unattendant-live/site/public
		}

		file_server
	}
}
