# unattendant.dev 정적 사이트. 외부 노출은 Cloudflare Tunnel만 쓰므로 127.0.0.1에만 붙는다.
# TLS는 Cloudflare가 맡는다.
{
	admin off
	auto_https off
	persist_config off
}

http://:8080 {
	bind 127.0.0.1
	root * /home/hun/unattendant-live/site/public
	encode zstd gzip

	# CSS·JS·글꼴은 파일 이름에 해시가 있어 내용이 바뀌면 이름도 바뀐다. 없으면 Cloudflare가 브라우저 캐시를 4시간(max-age=14400)으로 붙인다
	header /css/* Cache-Control "public, max-age=31536000, immutable"
	header /js/* Cache-Control "public, max-age=31536000, immutable"
	header /fonts/* Cache-Control "public, max-age=31536000, immutable"

	# 기본 보안 헤더. HSTS는 .dev 최상위 도메인이 브라우저에 HSTS 사전 등록돼 있어 따로 두지 않는다.
	# CSP: 스크립트는 이 사이트의 파일만(상태 띠 스크립트를 외부 파일 js/status.*.js로 뺀 사이트 판이 먼저 배포돼야 한다.
	# 그 전에 걸면 인라인 스크립트가 막혀 띠가 "운영 준비 중"에 머문다). 글 안 SVG가 style 속성을 써서 style은 inline을 허용한다.
	# JSON-LD(<script type="application/ld+json">)는 실행되지 않는 데이터라 script-src와 상관없다
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
	}

	# 상태 띠와 통계 탭이 읽는 Pi 상태 (docs/status.md). huninn-status.timer가 5분마다 /run/huninn(RAM)에 쓴다.
	# 사이트 빌드가 public/을 비우므로 거기에 두지 않는다. 캐시하지 않는다
	handle /status.json {
		root * /run/huninn
		header Cache-Control "no-store"
		file_server
	}

	handle {
		file_server
	}

	handle_errors 404 {
		handle /en/* {
			rewrite * /en/404.html
			file_server
		}
		handle {
			rewrite * /404.html
			file_server
		}
	}
}

# 승인 대기 초안의 미리보기 (docs/blogops.md 11절). preview.unattendant.dev → 터널 → 여기.
# 폴더 이름이 추측할 수 없는 토큰이고 폴더 목록은 보여 주지 않는다. 승인 대기가 끝나면 폴더가 지워진다.
# 읽기 전용 정적 서빙뿐이다. 이 포트로 들어온 요청은 초안을 바꿀 수 없다.
http://:8081 {
	bind 127.0.0.1
	root * /home/hun/unattendant-live/state/previews
	encode zstd gzip

	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	route {
		# 점으로 시작하는 이름(만드는 중인 폴더 등)은 내주지 않는다
		@hidden path_regexp hidden (^|/)\.
		respond @hidden 404

		respond /robots.txt <<TEXT
			User-agent: *
			Disallow: /
			TEXT 200

		# 사이트 CSS가 /fonts/…를, 상태 띠가 /status.json을 절대 경로로 부른다.
		# 글꼴은 공개 사이트 폴더에서, Pi 상태는 공개 사이트와 같은 /run/huninn에서 그대로 내준다.
		# 글꼴은 이름에 해시가 있는 공개 파일이라 캐시를 허용한다 (폰에서 페이지마다 다시 받지 않게)
		header /fonts/* Cache-Control "public, max-age=31536000, immutable"
		file_server /fonts/* {
			root /home/hun/unattendant-live/site/public
		}
		file_server /status.json {
			root /run/huninn
		}

		file_server
	}
}
