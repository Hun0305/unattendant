# Pi 상태 파일을 5분마다 쓴다 (huninn-status.service). 상태 띠는 30분 넘게 갱신이 없으면 "갱신 멈춤"을 보여 준다
# 설치와 확인: ops/README.md "Pi 상태 파일"
[Unit]
Description=Write the Pi status file every 5 minutes

[Timer]
OnCalendar=*:0/5
# /run은 재부팅하면 비워지므로 켜진 직후에도 한 번 쓴다
OnBootSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
